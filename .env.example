# Copy this file to .env and fill in your values. .env is git-ignored.

# Local PostgreSQL (the password you chose when installing Postgres)
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=

# Clerk — dashboard.clerk.com → your app → API keys
CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_

# Production only: Neon/Supabase connection string
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Resend (resend.com → API Keys). In development email is only sent when DEV_MAIL_TO is set,
# and every message goes to that inbox. Without a verified domain, Resend only delivers
# to the email of your Resend account, from onboarding@resend.dev.
RESEND_API_KEY=re_
DEV_MAIL_TO=
# MAIL_FROM="KOVZU <notificaciones@tudominio.co>"

# Production only: private Cloudflare R2 bucket for uploaded files (R2 → Manage API tokens)
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_BUCKET=kovzu
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Production only: public host used in email links
# APP_HOST=kovzu.onrender.com
