<% content_for :title, "KOVZU" %>

<section class="mx-auto max-w-6xl px-4 pt-20 pb-12 sm:pt-28">
  <p class="kz-overline">Producción por encargo</p>
  <h1 class="kz-display mt-4 max-w-3xl">Tus pedidos, con talleres verificados y cada paso a la vista.</h1>
  <p class="mt-6 max-w-xl text-lg text-ink-muted text-pretty">
    Cuéntanos qué necesitas fabricar. Te mostramos qué pasó, qué sigue y quién debe actuar en cada pedido.
  </p>

  <div class="mt-10 flex flex-wrap gap-3">
    <%= link_to sign_up_path, class: "kz-btn kz-btn--primary kz-btn--lg" do %>
      Crear cuenta <%= kz_glyph :arrow %>
    <% end %>
    <%= link_to "Ya tengo cuenta", sign_in_path, class: "kz-btn kz-btn--outline kz-btn--lg" %>
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 pb-24">
  <p class="kz-overline">Capacidades</p>
  <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% KzHelper::CAPABILITIES.each_key do |capability| %>
      <div class="kz-card p-6"><%= kz_capability capability %></div>
    <% end %>
  </div>
</section>
