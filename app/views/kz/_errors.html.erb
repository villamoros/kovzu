<%# locals: (record:) -%>
<% if record.errors.any? %>
  <div class="kz-alert kz-alert--danger" role="alert">
    <%= kz_glyph :alert, size: 20, class: "kz-alert__icon" %>
    <div>
      <p class="kz-alert__title">Revisa <%= record.errors.count == 1 ? "este campo" : "estos #{record.errors.count} campos" %></p>
      <ul class="kz-alert__body list-disc pl-4">
        <% record.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </div>
  </div>
<% end %>
