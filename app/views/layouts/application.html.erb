<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Kovzu" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300..800&family=Geist+Mono:wght@400..600&display=swap">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= clerk_script_tag %>
  </head>

  <body class="min-h-dvh bg-canvas text-ink font-sans antialiased selection:bg-accent/20">
    <div aria-hidden="true" class="backdrop"></div>

    <%= render "shared/navbar" %>

    <main class="relative">
      <%= yield %>
    </main>
  </body>
</html>
