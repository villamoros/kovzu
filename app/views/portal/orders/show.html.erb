<% content_for :title, "#{@order.code} · KOVZU" %>
<% proposal = @order.current_proposal %>

<div class="mx-auto max-w-6xl px-4 sm:px-6 py-8 grid grid-cols-1 gap-6">
  <%= render "kz/page_header", back: [ "Pedidos", orders_path ], overline: "Pedido #{@order.code}", title: @order.title,
        status: kz_status(@order.status) %>

  <% if proposal&.enviada? %>
    <section class="kz-card kz-card__body flex flex-wrap items-center justify-between gap-4">
      <div class="grid gap-1">
        <h2 class="kz-h3">Tu propuesta está lista</h2>
        <p class="text-sm text-ink-muted">Total <%= kz_money(proposal.total_cop) %> · entrega estimada el <%= kz_date(proposal.promised_on) %>.</p>
      </div>
      <%= link_to "Revisar propuesta", order_proposal_path(@order), class: "kz-btn kz-btn--primary" %>
    </section>
  <% elsif proposal&.cambios_solicitados? %>
    <div class="kz-alert" role="status">
      <%= kz_glyph :info, size: 20, class: "kz-alert__icon" %>
      <div><p class="kz-alert__title">Estamos ajustando la propuesta</p><p class="kz-alert__body">Recibimos tus comentarios: "<%= proposal.change_request %>". Te avisamos cuando esté la nueva.</p></div>
    </div>
  <% elsif proposal.nil? && (@order.en_preparacion? || @order.cotizando?) %>
    <div class="kz-alert" role="status">
      <%= kz_glyph :info, size: 20, class: "kz-alert__icon" %>
      <div><p class="kz-alert__title">Estamos cotizando</p><p class="kz-alert__body">Pedimos precio a talleres verificados con tu ficha técnica. Te enviamos una sola propuesta.</p></div>
    </div>
  <% end %>

  <% if proposal&.aceptada? %>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
      <%= render "kz/stat", label: "Entrega comprometida", value: kz_date(@order.promised_on) || "—", tone: :info %>
      <%= render "kz/stat", label: "Total", value: kz_money(proposal.total_cop), meta: proposal.fee_paid_before? ? "Fee ya pagado" : "Incluye fee de #{kz_money(proposal.management_fee_cop)}" %>
      <%= render "kz/stat", label: "Anticipo al taller", value: kz_money(proposal.advance_cop), meta: "#{proposal.advance_percent} % al confirmar" %>
      <%= render "kz/stat", label: "Saldo", value: kz_money(proposal.balance_cop), meta: "Al aprobar la inspección" %>
    </div>
  <% end %>

  <% @order.sub_orders.each do |sub_order| %>
    <% sheet = sub_order.current_tech_sheet %>
    <% sample = sub_order.samples.last %>
    <section class="kz-card">
      <div class="kz-card__header">
        <div class="flex flex-wrap items-center gap-3">
          <%= kz_icon sub_order.category.slug, size: 24 %>
          <h2 class="kz-card__title"><%= sub_order.title %></h2>
          <%= kz_status sub_order.status, kind: :sub_order %>
        </div>
        <span class="text-sm text-ink-muted"><%= "#{number_with_delimiter(sub_order.quantity, delimiter: ".")} u." if sub_order.quantity %><%= " · #{sub_order.workshop.name}" if sub_order.workshop %></span>
      </div>

      <% if sample&.por_revisar? %>
        <div class="kz-card__body grid gap-4 border-b border-line bg-warning-soft/40">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h3 class="kz-h3">Revisa la muestra <%= sample.number %></h3>
            <span class="text-sm text-ink-muted"><%= Sample::KINDS[sample.kind] %> · <%= kz_date(sample.created_at.to_date) %></span>
          </div>
          <%= render "portal/orders/photos", sample: %>
          <% if sample.notes.present? %><p class="text-sm"><%= sample.notes %></p><% end %>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 items-start">
            <%= button_to "Aprobar muestra", approve_sample_path(sample), class: "kz-btn kz-btn--primary w-full",
                  form: { data: { turbo_confirm: "¿Apruebas esta muestra? Queda como muestra patrón y el taller arranca la producción." } } %>
            <details class="kz-card">
              <summary class="px-4 py-3 cursor-pointer text-sm font-medium">Pedir ajustes</summary>
              <%= form_with url: reject_sample_path(sample), class: "px-4 pb-4 grid gap-3" do %>
                <div class="kz-field">
                  <label class="kz-label" for="comment_<%= sample.id %>">Qué hay que corregir</label>
                  <%= text_area_tag :comment, nil, id: "comment_#{sample.id}", class: "kz-textarea", required: true, placeholder: "El color del logo está más claro que el Pantone aprobado." %>
                  <p class="kz-hint">El taller recibe tus comentarios y fija una nueva fecha de muestra.</p>
                </div>
                <button class="kz-btn kz-btn--outline">Enviar comentarios</button>
              <% end %>
            </details>
          </div>
        </div>
      <% end %>

      <%= render "portal/orders/quality", order: @order, sub_order: %>

      <div class="grid grid-cols-1 lg:grid-cols-2">
        <div class="kz-card__body grid gap-4 content-start lg:border-r lg:border-line">
          <h3 class="kz-overline">Línea de tiempo</h3>
          <% if sub_order.milestones.any? %>
            <% current = sub_order.milestones.reject(&:done?).first %>
            <%= render "kz/timeline", milestones: sub_order.milestones.map { |milestone|
                  { title: milestone.title, state: milestone.timeline_state(current&.id), committed: milestone.committed_on,
                    actual: milestone.completed_on,
                    by: (milestone.rescheduled? ? "Antes #{kz_date(milestone.original_committed_on)}. #{milestone.reschedule_reason}" : nil) } } %>
          <% else %>
            <p class="text-sm text-ink-muted">Los hitos aparecen cuando aceptes la propuesta.</p>
          <% end %>
        </div>

        <div class="kz-card__body grid gap-4 content-start border-t border-line lg:border-t-0">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h3 class="kz-overline">Ficha técnica</h3>
            <% if sheet %><span class="flex items-center gap-2 text-sm">v<%= format("%02d", sheet.version) %> <%= kz_status sheet.status, kind: :tech_sheet %></span><% end %>
          </div>
          <% if sheet && (sheet.lista? || sheet.aceptada?) %>
            <%= render "portal/orders/tech_sheet", sheet: %>
          <% else %>
            <p class="text-sm text-ink-muted">La estamos preparando con lo que nos enviaste.</p>
          <% end %>

          <% reports = sub_order.inspections.select(&:cerrada?) %>
          <% if reports.any? %>
            <h3 class="kz-overline mt-2">Actas de inspección</h3>
            <ul class="grid gap-2 text-sm">
              <% reports.reverse_each do |report| %>
                <li class="flex flex-wrap items-center justify-between gap-2">
                  <%= link_to "Acta #{report.number} · #{kz_date(report.closed_at.to_date)}", order_inspection_path(@order, report), class: "kz-link" %>
                  <%= kz_status report.result, kind: :inspection_result %>
                </li>
              <% end %>
            </ul>
          <% end %>

          <% decided = sub_order.samples.reject(&:por_revisar?) %>
          <% if decided.any? %>
            <h3 class="kz-overline mt-2">Muestras</h3>
            <ul class="grid gap-3 text-sm">
              <% decided.reverse_each do |past| %>
                <li class="grid gap-1">
                  <span class="flex items-center gap-2">Muestra <%= past.number %> <%= kz_status past.status, kind: :sample %></span>
                  <% if past.comment.present? %><span class="text-ink-muted"><%= past.comment %></span><% end %>
                </li>
              <% end %>
            </ul>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>
</div>
