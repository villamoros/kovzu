<%# locals: (sample:) -%>
<ul class="grid grid-cols-2 sm:grid-cols-4 gap-2">
  <% sample.photos.each do |photo| %>
    <li>
      <%= link_to attachment_file_path(photo), target: "_blank", rel: "noopener", class: "block aspect-square overflow-hidden rounded-xl border border-line bg-surface-muted" do %>
        <%= image_tag attachment_file_path(photo), alt: "Foto de la muestra #{sample.number}", class: "h-full w-full object-cover", loading: "lazy" %>
      <% end %>
    </li>
  <% end %>
</ul>
