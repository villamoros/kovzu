<% content_for :title, "Tu empresa · KOVZU" %>

<div class="mx-auto max-w-2xl px-4 sm:px-6 py-10 grid grid-cols-1 gap-6">
  <%= render "kz/page_header", overline: "Bienvenido a KOVZU", title: "Cuéntanos de tu empresa" %>
  <p class="text-ink-muted -mt-2">Con estos datos armamos tus propuestas y te avisamos de cada paso de tus pedidos.</p>

  <%= form_with model: @company, url: company_path, class: "kz-card kz-card__body grid grid-cols-1 gap-5" do |f| %>
    <%= render "kz/errors", record: @company %>

    <div class="grid grid-cols-1 sm:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] gap-4">
      <div class="kz-field"><%= f.label :name, "Nombre de la empresa o marca", class: "kz-label" %><%= f.text_field :name, class: "kz-input", required: true, autofocus: true %></div>
      <div class="kz-field"><%= f.label :nit, class: "kz-label" do %>NIT <small>(opcional)</small><% end %><%= f.text_field :nit, class: "kz-input" %></div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="kz-field">
        <%= f.label :segment, "Tipo de empresa", class: "kz-label" %>
        <div class="kz-select-wrap"><%= f.select :segment, ClientCompany::SEGMENTS.invert, { include_blank: "Elige una opción" }, class: "kz-select" %></div>
      </div>
      <div class="kz-field"><%= f.label :city, "Ciudad", class: "kz-label" %><%= f.text_field :city, class: "kz-input" %></div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="kz-field"><%= f.label :contact_name, "Contacto", class: "kz-label" %><%= f.text_field :contact_name, class: "kz-input" %></div>
      <div class="kz-field"><%= f.label :contact_email, "Correo para avisos", class: "kz-label" %><%= f.email_field :contact_email, class: "kz-input" %></div>
      <div class="kz-field"><%= f.label :contact_phone, "Celular", class: "kz-label" %><%= f.telephone_field :contact_phone, class: "kz-input" %></div>
    </div>

    <label class="kz-check">
      <%= check_box_tag :data_consent, "1", params[:data_consent] == "1", required: true %>
      <span>Autorizo a KOVZU a tratar mis datos para gestionar mis pedidos, según la Ley 1581 de 2012.</span>
    </label>

    <div class="flex justify-end">
      <button class="kz-btn kz-btn--primary">Continuar</button>
    </div>
  <% end %>
</div>
