<% content_for :title, "#{@order.code} · KOVZU" %>

<div class="mx-auto max-w-6xl px-4 sm:px-6 py-8 grid grid-cols-1 gap-6">
  <%= render "kz/page_header", back: [ "Tablero", operator_root_path ],
        overline: "Pedido #{@order.code} · #{@order.client_company.name}", title: @order.title,
        status: kz_status(@order.status) %>

  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
    <%= render "kz/stat", label: "Tipo", value: Order::KINDS[@order.kind], meta: "#{@order.sub_orders.size} subpedido#{"s" unless @order.sub_orders.size == 1}" %>
    <%= render "kz/stat", label: "Fee de gestión", value: kz_money(@order.management_fee_cop) %>
    <%= render "kz/stat", label: "Entrega comprometida", value: kz_date(@order.promised_on) || "—" %>
    <%= render "kz/stat", label: "Atrasos", value: @order.milestones.count(&:late?), tone: @order.milestones.any?(&:late?) ? :danger : :neutral %>
  </div>

  <% if (proposal = @order.current_proposal) %>
    <%= render "operator/orders/proposal", proposal: %>
  <% end %>

  <% @order.sub_orders.each do |sub_order| %>
    <% sheet = sub_order.current_tech_sheet %>
    <section class="kz-card">
      <div class="kz-card__header">
        <div class="flex flex-wrap items-center gap-3">
          <%= kz_icon sub_order.category.slug, size: 24 %>
          <h2 class="kz-card__title"><%= sub_order.title %></h2>
          <%= kz_status sub_order.status, kind: :sub_order %>
        </div>
        <span class="text-sm text-ink-muted"><%= sub_order.category.name %><%= " · #{number_with_delimiter(sub_order.quantity, delimiter: ".")} u." if sub_order.quantity %><%= " · #{sub_order.workshop.name}" if sub_order.workshop %></span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2">
        <div class="kz-card__body grid gap-4 content-start lg:border-r lg:border-line">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h3 class="kz-overline">Ficha técnica</h3>
            <% if sheet %><span class="flex items-center gap-2 text-sm">v<%= format("%02d", sheet.version) %> <%= kz_status sheet.status, kind: :tech_sheet %></span><% end %>
          </div>
          <% if sheet %>
            <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
              <% sheet.template_fields.first(5).each do |field| %>
                <dt class="text-ink-muted"><%= field["label"] %></dt>
                <dd class="m-0 <%= "italic text-ink-muted" if sheet.value(field["key"]).blank? %>"><%= sheet.value(field["key"]).presence || "Pendiente" %></dd>
              <% end %>
            </dl>
            <div class="flex flex-wrap gap-2">
              <%= link_to (sheet.editable? ? "Editar ficha" : "Ver o crear versión nueva"), edit_operator_tech_sheet_path(sheet), class: "kz-btn kz-btn--outline kz-btn--sm" %>
              <% if (sheet.lista? || sheet.aceptada?) && sub_order.quotes.empty? && sub_order.preparacion? %>
                <%= link_to "Pedir cotizaciones", new_operator_sub_order_quote_request_path(sub_order), class: "kz-btn kz-btn--primary kz-btn--sm" %>
              <% end %>
            </div>
          <% end %>
        </div>

        <div class="kz-card__body grid gap-4 content-start border-t border-line lg:border-t-0">
          <h3 class="kz-overline">Línea de tiempo</h3>
          <% if sub_order.milestones.any? %>
            <% current = sub_order.milestones.reject(&:done?).first %>
            <%= render "kz/timeline", milestones: sub_order.milestones.map { |milestone|
                  { title: milestone.title, state: milestone.timeline_state(current&.id), committed: milestone.committed_on,
                    actual: milestone.completed_on, by: (milestone.rescheduled? ? "Antes #{kz_date(milestone.original_committed_on)}. #{milestone.reschedule_reason}" : nil) } } %>
          <% else %>
            <p class="text-sm text-ink-muted">Los hitos se crean cuando el cliente acepta la propuesta.</p>
          <% end %>
        </div>
      </div>

      <% if sub_order.quotes.any? %>
        <%= render "operator/orders/quotes", order: @order, sub_order: %>
      <% end %>

      <% if sub_order.samples.any? || sub_order.can_register_sample? %>
        <%= render "operator/orders/samples", sub_order: %>
      <% end %>

      <% if sub_order.workshop && !sub_order.status.in?(%w[preparacion cotizando asignado]) %>
        <%= render "operator/orders/production", sub_order: %>
      <% end %>
    </section>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
    <% if @order.requirement %>
      <section class="kz-card kz-card__body grid gap-2">
        <h2 class="kz-overline">Requerimiento de origen</h2>
        <%= link_to @order.requirement.title, operator_requirement_path(@order.requirement), class: "kz-link font-medium" %>
        <p class="text-sm text-ink-muted">Recibido el <%= kz_date(@order.requirement.submitted_at.to_date) %> por <%= Requirement::CHANNELS[@order.requirement.channel] %>.</p>
      </section>
    <% end %>

    <section class="kz-card">
      <div class="kz-card__header"><h2 class="kz-card__title">Bitácora</h2></div>
      <% if @events.empty? %>
        <p class="kz-empty">Sin eventos.</p>
      <% else %>
        <ol class="divide-y divide-line">
          <% @events.each do |event| %>
            <li class="flex justify-between gap-4 px-6 py-3 text-sm">
              <span><%= t("audit.#{event.action}", default: event.action.humanize) %><span class="text-ink-muted"> · <%= event.actor_name %></span></span>
              <time class="text-ink-muted tabular-nums whitespace-nowrap" datetime="<%= event.created_at.iso8601 %>"><%= kz_date(event.created_at.to_date) %> <%= event.created_at.strftime("%H:%M") %></time>
            </li>
          <% end %>
        </ol>
      <% end %>
    </section>
  </div>
</div>
