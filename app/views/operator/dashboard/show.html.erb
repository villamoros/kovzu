<% content_for :title, "Tablero · KOVZU" %>
<% counts = @dashboard.counts_by_status %>
<% queue = @dashboard.requirements_in_queue.to_a %>
<% waiting_quotes = @dashboard.quotes_waiting.to_a %>

<div class="mx-auto max-w-6xl px-4 sm:px-6 py-8 grid grid-cols-1 gap-8">
  <%= render "kz/page_header", overline: "Operación · #{kz_date(Date.current)}", title: "Tablero",
        actions: safe_join([
          link_to(safe_join([ kz_glyph(:plus), "Registrar requerimiento" ]), new_operator_requirement_path, class: "kz-btn kz-btn--primary"),
          link_to("Nuevo taller", new_operator_workshop_path, class: "kz-btn kz-btn--outline")
        ]) %>

  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
    <%= link_to operator_requirements_path, class: "contents" do %>
      <%= render "kz/stat", label: "Requerimientos en cola", value: format("%02d", queue.size), meta: "#{queue.count(&:esperando_cliente?)} esperando cliente" %>
    <% end %>
    <%= render "kz/stat", label: "Cotizando", value: format("%02d", counts.fetch("cotizando", 0)), tone: :info, meta: "#{waiting_quotes.size} sin respuesta" %>
    <%= render "kz/stat", label: "En curso", value: format("%02d", counts.fetch("en_curso", 0) + counts.fetch("confirmado", 0)), tone: :info %>
    <%= render "kz/stat", label: "Requieren atención", value: format("%02d", @dashboard.attention_orders.size),
          tone: @dashboard.attention.any? { |item| item.tone == :danger } ? :danger : :warning,
          meta: "#{@dashboard.attention.count { |item| item.tone == :danger }} con atraso" %>
  </div>

  <%= form_with url: operator_root_path, method: :get, class: "kz-card p-4 grid grid-cols-1 sm:grid-cols-[1fr_1fr_1fr_auto] gap-3 items-end" do %>
    <div class="kz-field">
      <label class="kz-label" for="workshop_id">Taller</label>
      <div class="kz-select-wrap"><%= select_tag :workshop_id, options_from_collection_for_select(Workshop.order(:name), :id, :name, params[:workshop_id]), include_blank: "Todos", class: "kz-select" %></div>
    </div>
    <div class="kz-field">
      <label class="kz-label" for="category_id">Categoría</label>
      <div class="kz-select-wrap"><%= select_tag :category_id, options_from_collection_for_select(Category.active, :id, :name, params[:category_id]), include_blank: "Todas", class: "kz-select" %></div>
    </div>
    <div class="kz-field">
      <label class="kz-label" for="client_company_id">Cliente</label>
      <div class="kz-select-wrap"><%= select_tag :client_company_id, options_from_collection_for_select(ClientCompany.order(:name), :id, :name, params[:client_company_id]), include_blank: "Todos", class: "kz-select" %></div>
    </div>
    <div class="flex gap-2">
      <button class="kz-btn kz-btn--secondary">Filtrar</button>
      <% if @dashboard.filtered? %><%= link_to "Limpiar", operator_root_path, class: "kz-btn kz-btn--ghost" %><% end %>
    </div>
  <% end %>

  <% if (late_workshops = @dashboard.delinquent_workshops.to_a).any? %>
    <div class="kz-alert kz-alert--danger" role="alert">
      <%= kz_glyph :alert, size: 20, class: "kz-alert__icon" %>
      <div>
        <p class="kz-alert__title"><%= late_workshops.map(&:name).to_sentence %> en mora con comisiones</p>
        <p class="kz-alert__body">Más de <%= Commission::DELINQUENT_DAYS %> días sin pagar: sus asignaciones quedan en pausa. <%= link_to "Ver cartera", operator_commissions_path, class: "kz-link" %></p>
      </div>
    </div>
  <% end %>

  <% if (refunds = @dashboard.refunds_pending.to_a).any? %>
    <div class="kz-alert kz-alert--warning" role="status">
      <%= kz_glyph :alert, size: 20, class: "kz-alert__icon" %>
      <div>
        <p class="kz-alert__title">Anticipos por devolver</p>
        <p class="kz-alert__body">
          <% refunds.each_with_index do |refund, index| %><%= "; " if index.positive? %><%= refund.workshop.name %>: <%= kz_money(refund.refund_cop) %> (<%= link_to refund.order.code, operator_order_path(refund.order), class: "kz-link" %>)<% end %>.
          Regístralos en el pedido cuando lleguen (RN-05).
        </p>
      </div>
    </div>
  <% end %>

  <% if @dashboard.attention.any? %>
    <section class="kz-card">
      <div class="kz-card__header">
        <h2 class="kz-card__title">Requieren atención</h2>
        <span class="kz-count"><%= @dashboard.attention.size %></span>
      </div>
      <div class="kz-table-wrap">
        <table class="kz-table">
          <thead><tr><th>Pedido</th><th>Producto</th><th>Cliente</th><th>Motivo</th><th class="is-num">Fecha</th></tr></thead>
          <tbody>
            <% @dashboard.attention.each do |item| %>
              <tr>
                <td><%= link_to item.order.code, operator_order_path(item.order), class: "kz-code kz-link" %></td>
                <td><%= item.order.title %></td>
                <td class="is-meta"><%= item.order.client_company.name %></td>
                <td><span class="kz-status kz-status--<%= item.tone %>"><%= item.reason %></span></td>
                <td class="is-num"><%= kz_date(item.due_on) || "—" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] gap-8 items-start">
    <section class="kz-card">
      <div class="kz-card__header">
        <h2 class="kz-card__title">Pedidos abiertos por estado</h2>
        <span class="kz-count"><%= @dashboard.orders.size %></span>
      </div>
      <% if @dashboard.orders.empty? %>
        <p class="kz-empty"><%= @dashboard.filtered? ? "Ningún pedido abierto con estos filtros." : "Aún no hay pedidos abiertos. Empiezan cuando un requerimiento queda completo." %></p>
      <% else %>
        <div class="kz-table-wrap">
          <table class="kz-table">
            <thead><tr><th>Pedido</th><th>Producto</th><th>Taller</th><th>Subpedido</th><th class="is-num">Entrega</th></tr></thead>
            <% @dashboard.orders.group_by(&:status).sort_by { |status, _| StatusCatalog.keys(:order).index(status) }.each do |status, orders| %>
              <tbody>
                <tr><th colspan="5" class="!pt-5"><%= kz_status status %> <span class="kz-count ml-1"><%= orders.size %></span></th></tr>
                <% orders.each do |order| %>
                  <% sub_order = order.sub_orders.first %>
                  <tr>
                    <td><%= link_to order.code, operator_order_path(order), class: "kz-code kz-link" %></td>
                    <td><%= order.title %><div class="text-xs text-ink-muted"><%= order.client_company.name %></div></td>
                    <td class="is-meta"><%= sub_order&.workshop&.name || "Sin asignar" %></td>
                    <td><%= kz_status sub_order.status, kind: :sub_order if sub_order %></td>
                    <td class="is-num"><%= kz_date(order.promised_on) || "—" %></td>
                  </tr>
                <% end %>
              </tbody>
            <% end %>
          </table>
        </div>
      <% end %>
    </section>

    <div class="grid gap-8">
      <section class="kz-card">
        <div class="kz-card__header">
          <h2 class="kz-card__title">Cola de requerimientos</h2>
          <%= link_to "Ver todos", operator_requirements_path, class: "kz-link text-sm" %>
        </div>
        <% if queue.empty? %>
          <p class="kz-empty">No hay requerimientos por revisar.</p>
        <% else %>
          <ul class="divide-y divide-line">
            <% queue.first(6).each do |requirement| %>
              <li>
                <%= link_to operator_requirement_path(requirement), class: "flex items-start justify-between gap-3 px-6 py-3 hover:bg-ground" do %>
                  <span class="grid gap-0.5 min-w-0">
                    <span class="text-sm font-medium truncate"><%= requirement.title %></span>
                    <span class="text-xs text-ink-muted"><%= requirement.client_company.name %> · hace <%= pluralize(requirement.waiting_days, "día hábil", plural: "días hábiles") %></span>
                  </span>
                  <%= kz_status requirement.status, kind: :requirement %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </section>

      <section class="kz-card">
        <div class="kz-card__header"><h2 class="kz-card__title">Cotizaciones sin respuesta</h2></div>
        <% if waiting_quotes.empty? %>
          <p class="kz-empty">Ningún taller tiene cotizaciones pendientes.</p>
        <% else %>
          <ul class="divide-y divide-line">
            <% waiting_quotes.first(6).each do |quote| %>
              <li class="flex items-start justify-between gap-3 px-6 py-3">
                <span class="grid gap-0.5 min-w-0">
                  <span class="text-sm font-medium"><%= quote.workshop.name %></span>
                  <span class="text-xs text-ink-muted"><%= link_to quote.sub_order.order.code, operator_order_path(quote.sub_order.order), class: "kz-link" %> · enlace <%= quote.link_expired? ? "vencido" : "vence #{kz_date(quote.link_expires_at.to_date)}" %></span>
                </span>
                <%= kz_status(quote.link_expired? ? "vencida" : quote.status, kind: :quote) %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </section>
    </div>
  </div>
</div>
