<% content_for :title, "Dashboard · Kovzu" %>

<section class="mx-auto max-w-6xl px-4 py-16">
  <p class="text-sm text-muted">Dashboard</p>
  <h1 class="mt-1 text-3xl font-semibold tracking-tight">Hola, <%= current_user.first_name.presence || current_user.name %></h1>

  <div class="mt-8 grid gap-4 sm:grid-cols-3">
    <article class="card sm:col-span-2">
      <h2 class="font-medium">Todo listo</h2>
      <p class="mt-1 text-sm text-muted">Tu sesión viene de Clerk y tu usuario ya está guardado en PostgreSQL.</p>
    </article>
    <article class="card">
      <p class="text-sm text-muted">Email</p>
      <p class="mt-1 truncate font-mono text-sm"><%= current_user.email %></p>
    </article>
  </div>
</section>
